[Unit]
Description=CLIMAC Wetter-App: Tankerkoenig Stationsabruf (Stammdaten + Preise) -> SFTP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mp01
WorkingDirectory=/opt/climac/web/wetter-app/pi-scripts
ExecStart=/usr/bin/python3 /opt/climac/web/wetter-app/pi-scripts/export_tanken_stations.py
