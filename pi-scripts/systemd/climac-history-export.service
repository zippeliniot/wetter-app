[Unit]
Description=CLIMAC Wetter-App: History-Export (Jahres-/DOY-Kurven -> SFTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mp01
WorkingDirectory=/opt/climac/web/wetter-app/pi-scripts
ExecStart=/usr/bin/python3 /opt/climac/web/wetter-app/pi-scripts/export_history.py
